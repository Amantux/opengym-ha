# The build context is this folder (the Supervisor builds the add-on from it). The image
# needs only patches/, gateway/package.json, gateway/src/, gateway/web/, integration/ and
# rootfs/; keep the rest, and anything a developer machine leaves behind, out of the context
# (Python byte-code too: integration/ is copied into Home Assistant as it is).
**/node_modules
**/coverage
**/.DS_Store
**/*.log
**/__pycache__
**/*.pyc
gateway/test
gateway/tests
